void setup() {
    Serial.begin(115200);
    while (!Serial && millis() < 3000);

    Serial.println("\n=======================================================");
    Serial.println("  CHEBYSHEV-COMPRESSOR: TINYML ON-DEVICE INFERENCE");
    Serial.println("=======================================================");
    Serial.printf("Task             : NASA C-MAPSS Turbofan Degradation\n");
    Serial.printf("Channels         : %d Sensors\n", CHEB_NUM_CHANNELS);
    Serial.printf("Chebyshev Order  : K=%d\n", CHEB_ORDER);
    Serial.printf("Flash Footprint  : ~14.8 KB (.rodata)\n");
    Serial.printf("RAM State Buffer : %d bytes (0 bytes malloc)\n", (int)sizeof(chebyshev_state_t));
    Serial.printf("Model Checksum   : 0x%08X\n", (unsigned int)CHEB_MODEL_CHECKSUM);
    Serial.println("=======================================================\n");

    chebyshev_init(&g_cheb_state);
}

void loop() {
    Serial.println("--- Starting 50-Step Turbofan Sensor Streaming Run ---");

    chebyshev_reset(&g_cheb_state);
    uint32_t total_latency_us = 0;

    for (int t = 0; t < 50; t++) {
        float predicted_rul = 0.0f;

        uint32_t t0 = GET_MICROS();
        chebyshev_step(&g_cheb_state, SAMPLE_DATA[t], &predicted_rul);
        uint32_t dt = GET_MICROS() - t0;

        total_latency_us += dt;

        /* Print telemetry every 5 steps */
        if (t % 5 == 0 || t == 49) {
            Serial.printf("Step [%02d/50] | Pred RUL: %5.1f%% | Step Latency: %4u us\n",
                          t + 1, predicted_rul * 100.0f, dt);
        }
        delay(20);
    }

    Serial.println("-------------------------------------------------------");
    Serial.printf("Total Streaming Time: %u us | Avg Latency: %.2f us/step\n",
                  total_latency_us, (float)total_latency_us / 50.0f);
    Serial.println("Streaming run complete. Restarting in 5 seconds...\n");

    delay(5000);
}
